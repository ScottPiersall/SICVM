<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SIC.Avalonia.App"
             xmlns:local="using:SIC.Avalonia"
             RequestedThemeVariant="Light">
             <!-- Using Light theme to match original Windows Forms app -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>