<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SIC.Avalonia.Views.Dialogs.StopAtMemoryAddressDialog"
        Title="Stop At Memory Address"
        Width="450" Height="280"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <StackPanel Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Last Loaded File" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="txtLastLoadedFile" IsReadOnly="True" Margin="0,5"/>
            
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Last Loaded Start Address" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="txtLastLoadedStart" IsReadOnly="True" Margin="0,5"/>
            
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Loaded Length" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="2" Grid.Column="1" Name="txtLastLoadedLength" IsReadOnly="True" Margin="0,5"/>
            
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Calculated Halting Point" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="3" Grid.Column="1" Name="txtCalculatedHaltingPoint" IsReadOnly="True" Margin="0,5"/>
        </Grid>
        
        <TextBlock Text="HALT RUN When PC Reaches Address (in Hex)" FontWeight="Bold" Margin="0,15,0,5"/>
        <TextBox Name="txtAddress" MaxLength="4" Text="0000" Width="120" HorizontalAlignment="Left"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Name="btnOK" Content="OK" Width="75" Margin="5" Click="OnOkClick"/>
            <Button Name="btnCancel" Content="Cancel" Width="75" Margin="5" Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>

